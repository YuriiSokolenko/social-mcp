# Application
APP_NAME=Social MCP
ENVIRONMENT=development

# Storage
DATABASE_URL=sqlite:///./data/social-mcp.db

# Web Admin: set these locally before using /admin. The username and password
# authenticate the login, but every /admin route is gated on a signed session
# cookie. ADMIN_SESSION_SECRET signs that cookie and must never be committed;
# the service denies all admin requests (and all logins) when it is missing.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# A strong random secret for signing session cookies. Generate one per
# deployment and keep it out of Git, for example:
#
#   export ADMIN_SESSION_SECRET="$(python -c 'import secrets; print(secrets.token_urlsafe(64))')"
#
# A file-based alternative is supported via ADMIN_SESSION_SECRET_FILE, pointing
# at a file (e.g. secrets/admin_session_secret) that holds the secret.
ADMIN_SESSION_SECRET=
# ADMIN_SESSION_SECRET_FILE=secrets/admin_session_secret

# Secret used to sign OAuth ``state`` values issued during the Threads
# authorization-code flow (issue #15). Generate a strong random value per
# deployment and keep it out of Git, for example:
#   export OAUTH_STATE_SECRET="$(python -c 'import secrets; print(secrets.token_urlsafe(64))')"
# A file-based alternative is supported via OAUTH_STATE_SECRET_FILE, pointing
# at a file (e.g. secrets/oauth_state_secret) that holds the secret.
# This is distinct from ADMIN_SESSION_SECRET (session cookies) and
# TOKEN_ENCRYPTION_KEY (encrypted tokens); each must stay outside the
# database and Git.
OAUTH_STATE_SECRET=
# OAUTH_STATE_SECRET_FILE=secrets/oauth_state_secret

# Meta / Threads
# The Threads App ID and App Secret shown in the Meta for Developers App
# Dashboard > App settings > Basic > Threads App ID / Threads App secret.
# They are used only server-side during the OAuth token exchange (issue #16);
# they are never sent to the browser or bundled into the image. Keep them out
# of Git via your runtime environment (see docs/oauth.md).
META_APP_ID=
META_APP_SECRET=
# The redirect URI registered for this app must exactly match the OAuth
# callback route. The default development callback is:
#   http://127.0.0.1:8000/admin/oauth/callback/threads
# Add it to the App Dashboard's list of valid OAuth URIs. The required minimum
# scope is threads_basic; request additional scopes only as needed (see
# docs/oauth.md for the full list).
# THREADS_REDIRECT_URI=
# THREADS_SCOPES=threads_basic,threads_content_publish

# TikTok
# The TikTok Client Key and Client Secret from the TikTok for Developers portal.
# Used only server-side during the TikTok OAuth token exchange. Keep them out
# of Git via your runtime environment.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Token encryption key: REQUIRED at startup. It encrypts every OAuth token at
# rest and must never be committed. Generate a strong random key per deployment
# and provide it through your environment or secret manager, for example:
#
#   export TOKEN_ENCRYPTION_KEY="$(python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
#
# A file-based alternative is also supported via TOKEN_ENCRYPTION_KEY_FILE,
# which points at a file holding the key (e.g. secrets/token_encryption_key).
# Never commit a real key.

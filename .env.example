# Application
APP_NAME=Social MCP
ENVIRONMENT=development

# Storage
DATABASE_URL=sqlite:///./data/social-mcp.db

# Web Admin: set these locally before using /admin. The username and password
# authenticate the login, but every /admin route is gated on a signed session
# cookie. ADMIN_SESSION_SECRET signs that cookie and must never be committed;
# the service denies all admin requests (and all logins) when it is missing.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# A strong random secret for signing session cookies. Generate one per
# deployment and keep it out of Git, for example:
#
#   export ADMIN_SESSION_SECRET="$(python -c 'import secrets; print(secrets.token_urlsafe(64))')"
#
# A file-based alternative is supported via ADMIN_SESSION_SECRET_FILE, pointing
# at a file (e.g. secrets/admin_session_secret) that holds the secret.
ADMIN_SESSION_SECRET=
# ADMIN_SESSION_SECRET_FILE=secrets/admin_session_secret

# Meta / Threads
META_APP_ID=
META_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Token encryption key: REQUIRED at startup. It encrypts every OAuth token at
# rest and must never be committed. Generate a strong random key per deployment
# and provide it through your environment or secret manager, for example:
#
#   export TOKEN_ENCRYPTION_KEY="$(python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
#
# A file-based alternative is also supported via TOKEN_ENCRYPTION_KEY_FILE,
# which points at a file holding the key (e.g. secrets/token_encryption_key).
# Never commit a real key.

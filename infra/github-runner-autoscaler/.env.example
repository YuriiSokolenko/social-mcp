# Recommended explicit host overrides. manager.sh owns Pi-pool fallback defaults.
GITHUB_REPOSITORY=YuriiSokolenko/social-mcp
GH_ADMIN_TOKEN=
PI_RUNNER_MANAGER_IMAGE=n150/pi-runner-manager:run-check-docker-0.1.9
MAX_RUNNERS=8
# Capacity belongs to the selected model runtime; set to 4 when using Laguna.
MODEL_MAX_CONCURRENCY=8
# queued_jobs() is one GitHub API request per status (repo-wide, filtered by
# path client-side) regardless of how many workflow files are watched, so
# this can stay low without threatening the 5,000/hour token budget -- see
# the queued_jobs comment in manager.sh for the request-count math.
POLL_SECONDS=6
RUNNER_IMAGE=n150/github-pi-runner-ephemeral:1.1.0-mini-swe-r4
# Explicit, independently versioned image used only by the trusted run_check executor.
RUN_CHECK_SANDBOX_IMAGE=n150/run-check-sandbox:0.1.2
RUN_CHECK_EXECUTOR_URL=http://127.0.0.1:17343
RUN_CHECK_EXECUTOR_PORT=17343
RUN_CHECK_STAGE_VOLUME=social-mcp-run-check-stage
RUNNER_PREFIX=n150-pi-eph
WORKFLOW_FILES=pi-issue-agent.yml,pi-pr-review.yml,pi-pr-fix.yml,pi-dispatcher.yml,pi-architect.yml,pi-triage.yml,verify-run-check-beelink.yml
# Point to the active llama.cpp /slots or vLLM /metrics endpoint.
MODEL_STATUS_URL=
PI_HOME_HOST=/home/yurasik/github-runners/social-mcp-pi/pi-home
PI_ZOEKT_URL=http://127.0.0.1:6070
PI_ZOEKT_REPOSITORY=YuriiSokolenko/social-mcp
PI_ZOEKT_TIMEOUT_MS=3000
# Per-call deadlines so one unresponsive GitHub API or Docker call cannot
# freeze the manager loop indefinitely. Defaults are usually fine.
CURL_CONNECT_TIMEOUT_SECONDS=5
CURL_MAX_TIME_SECONDS=15
DOCKER_TIMEOUT_SECONDS=30

# Second pool: plain CI, no Pi/LLM agent, no MODEL_STATUS_URL gate --
# MAX_RUNNERS is the only cap. The N150 box is 4 cores; start conservative
# (3-4) and only raise it after watching real CPU/RAM headroom under load,
# since each ci.yml `docker` job also builds/runs its own Compose stack.
GENERAL_MAX_RUNNERS=3
GENERAL_POLL_SECONDS=6
# Expensive Docker metadata walk; normal polls use docker info only.
GENERAL_DOCKER_DEEP_PROBE_INTERVAL_SECONDS=300
GENERAL_RUNNER_IMAGE=n150/github-general-runner-ephemeral:0.87.10
# Optional persistent pip cache path on the host; prepare ownership for runner UID/GID first.
PIP_CACHE_HOST_DIR=
GENERAL_RUNNER_PREFIX=n150-gen-eph
GENERAL_RUNNER_LABELS=n150,general
# Every workflow file with a job on the `general` label, not just ci.yml --
# check `grep -rl 'n150, *general' .github/workflows/` when adding a new
# workflow here; a file missing from this list queues forever with no
# manager watching it (this bit us once: pi-usage.yml was left out).
GENERAL_WORKFLOW_FILES=ci.yml,pi-auto-merge.yml,pi-reconcile.yml,pi-usage.yml

# Dedicated persistent control-plane runner. It is a single always-on runner,
# not an autoscaled pool, and must keep labels distinct from general/pi-agent.
CONTROL_RUNNER_IMAGE=n150/github-control-runner:0.1.7
CONTROL_RUNNER_NAME=n150-control
CONTROL_RUNNER_LABELS=n150,control
CONTROL_RUNNER_STATE_VOLUME=social-mcp-control-runner-state
CONTROL_REPAIR_COOLDOWN_SECONDS=300
CONTROL_RETRY_SECONDS=30
CONTROL_SHORT_RETRY_SECONDS=5
CONTROL_UPDATE_WAIT_SECONDS=30
CONTROL_UPDATE_SHUTDOWN_WAIT_SECONDS=90
CONTROL_CHILD_STOP_WAIT_SECONDS=30

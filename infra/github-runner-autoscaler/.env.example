GITHUB_REPOSITORY=YuriiSokolenko/social-mcp
GH_ADMIN_TOKEN=
MAX_RUNNERS=2
POLL_SECONDS=10
RUNNER_IMAGE=n150/github-pi-runner-ephemeral:0.87.1
RUNNER_PREFIX=n150-pi-eph
WORKFLOW_FILES=pi-issue-agent.yml,pi-pr-review.yml,pi-dispatcher.yml,pi-architect.yml
# Set to the active vLLM server's /metrics URL, reachable from the manager container.
MODEL_METRICS_URL=
PI_HOME_HOST=/home/yurasik/github-runners/social-mcp-pi/pi-home

{
  "mcpServers": {
    "lsp": {
      "command": "lsp-mcp-server",
      "lifecycle": "lazy",
      "idleTimeout": 15,
      "requestTimeoutMs": 125000,
      "exposeResources": false,
      "toolPrefix": "none",
      "includeTools": [
        "lsp_server_status",
        "lsp_start_server",
        "lsp_goto_definition",
        "lsp_find_references",
        "lsp_find_implementations",
        "lsp_find_symbol",
        "lsp_call_hierarchy",
        "lsp_smart_search"
      ],
      "directTools": [
        "lsp_server_status",
        "lsp_start_server",
        "lsp_goto_definition",
        "lsp_find_references",
        "lsp_find_implementations",
        "lsp_find_symbol",
        "lsp_call_hierarchy",
        "lsp_smart_search"
      ]
    },
    "git-context": {
      "command": "git-context-mcp",
      "lifecycle": "lazy",
      "idleTimeout": 30,
      "requestTimeoutMs": 60000,
      "exposeResources": false,
      "toolPrefix": "none",
      "includeTools": [
        "blame_context",
        "commit_story",
        "file_history",
        "search_commits",
        "file_contributors"
      ],
      "directTools": [
        "blame_context",
        "commit_story",
        "file_history",
        "search_commits",
        "file_contributors"
      ]
    }
  }
}
